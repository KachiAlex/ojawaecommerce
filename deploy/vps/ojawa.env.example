# Ojawa VPS environment — copy to deploy/vps/ojawa.env and fill in real values
# (ojawa.env is gitignored; never commit secrets)

# Database (container)
POSTGRES_USER=ojawa
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ojawa_db
# DATABASE_URL is assembled by docker-compose from the values above.

# Auth
JWT_SECRET=generate-a-long-random-string
JWT_EXPIRES_IN=7d

# App URLs
FRONTEND_URL=https://ojawa.africa
BACKEND_BASE_URL=https://ojawa.africa
ALLOWED_ORIGINS=https://ojawa.africa,https://www.ojawa.africa

# Sequelize sync: 'false' is REQUIRED for prod — 'true' runs unsafe ALTERs
# (crashed on enum casts against imported data). Manage schema via migrations.
DB_SYNC_ALTER=false

# Web push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@ojawa.africa

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@ojawa.africa

# Google Maps Platform (logistics/geocoding)
GOOGLE_MAPS_API_KEY=

# Google OAuth sign-in (optional; required for "Sign in with Google")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://ojawa.africa/api/auth/google/callback

# Payments
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
